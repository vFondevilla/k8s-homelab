# EXAMPLE ONLY. Store the completed file OUTSIDE this public Git repository:
# ~/.config/hermes-http/access.env (directory 0700, file 0600).
# Empty credentials are intentional: configure a real provider before startup.
HERMES_DASHBOARD_PUBLIC_URL=https://hermes.apps.fondevilla.io

# Single-user login is for a trusted LAN/VPN only, NOT direct Internet exposure.
# Prefer a password hash over a plaintext password.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=victor
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Alternatively configure a PUBLIC OIDC client with PKCE S256 in your IdP.
# Callback: https://hermes.apps.fondevilla.io/auth/callback
# Restrict IdP application access to Victor; dashboard access is administrative.
# HERMES_DASHBOARD_OIDC_ISSUER=
# HERMES_DASHBOARD_OIDC_CLIENT_ID=

API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=
# Browser-to-API CORS is deliberately disabled. Use a server-side API client.

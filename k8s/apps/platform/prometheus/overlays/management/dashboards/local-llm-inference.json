{
  "uid": "local-llm-inference",
  "title": "Local LLM Inference",
  "tags": [
    "llm",
    "inference"
  ],
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "model",
        "label": "Model",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"local-llm\"}, served_model)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(up{job=\"local-llm\"}, served_model)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scrape health",
      "description": "Latest Prometheus scrape for each model endpoint.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"local-llm\",served_model=~\"$model\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Completed requests since restart",
      "description": "Lifetime completions reported by each running server.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "halogen:requests_total{job=\"local-llm\",served_model=~\"$model\"} or ds4_requests_total{job=\"local-llm\",served_model=~\"$model\",outcome=\"completed\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Generated tokens since restart",
      "description": "Lifetime output token counter for the current server process.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:tokens_predicted_total{job=\"local-llm\",served_model=~\"$model\"} or ds4_tokens_decoded_total{job=\"local-llm\",served_model=~\"$model\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Running and queued requests",
      "description": "Concurrent requests at each scrape. Dashed lines show requests waiting to start.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 7,
            "showPoints": "never",
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:requests_processing{job=\"local-llm\",served_model=~\"$model\"} or ds4_requests_inflight{job=\"local-llm\",served_model=~\"$model\"}",
          "legendFormat": "{{instance}} · running"
        },
        {
          "refId": "B",
          "expr": "llamacpp:requests_deferred{job=\"local-llm\",served_model=~\"$model\"} or ds4_queue_depth{job=\"local-llm\",served_model=~\"$model\"}",
          "legendFormat": "{{instance}} · queued"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Completed requests per minute",
      "description": "Completions per minute averaged over the Prometheus rate window.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: req/min",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 7,
            "showPoints": "never",
            "lineInterpolation": "linear"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * (rate(halogen:requests_total{job=\"local-llm\",served_model=~\"$model\"}[$__rate_interval]) or rate(ds4_requests_total{job=\"local-llm\",served_model=~\"$model\",outcome=\"completed\"}[$__rate_interval]))",
          "legendFormat": "{{served_model}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Output throughput",
      "description": "Generated tokens per second of wall time, including idle periods.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 7,
            "showPoints": "never",
            "lineInterpolation": "linear"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(llamacpp:tokens_predicted_total{job=\"local-llm\",served_model=~\"$model\"}[$__rate_interval]) or rate(ds4_tokens_decoded_total{job=\"local-llm\",served_model=~\"$model\"}[$__rate_interval])",
          "legendFormat": "{{served_model}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Decode speed",
      "description": "Engine-reported generation speed. Halogen reports the last scrape interval. DS4 reports a rolling estimate.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 7,
            "showPoints": "never",
            "lineInterpolation": "linear"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:predicted_tokens_seconds{job=\"local-llm\",served_model=~\"$model\"} or ds4_decode_tok_s{job=\"local-llm\",served_model=~\"$model\"}",
          "legendFormat": "{{served_model}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Prompt processing and cache reuse",
      "description": "Input tokens per second, split by tokens computed and tokens served from the prompt cache.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 7,
            "showPoints": "never",
            "lineInterpolation": "linear"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(llamacpp:prompt_tokens_total{job=\"local-llm\",served_model=~\"$model\"}[$__rate_interval]) or rate(ds4_tokens_prefilled_total{job=\"local-llm\",served_model=~\"$model\",kind=\"computed\"}[$__rate_interval])",
          "legendFormat": "{{instance}} · computed"
        },
        {
          "refId": "B",
          "expr": "rate(halogen:prompt_tokens_cached_total{job=\"local-llm\",served_model=~\"$model\"}[$__rate_interval]) or rate(ds4_tokens_prefilled_total{job=\"local-llm\",served_model=~\"$model\",kind=\"cached\"}[$__rate_interval])",
          "legendFormat": "{{instance}} · cached"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Failures, cancellations and queue exits",
      "description": "Halogen counts requests that leave its queue before starting. DS4 reports terminal outcomes. Each line is a rate per minute.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: req/min",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 7,
            "showPoints": "never",
            "lineInterpolation": "linear"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * rate(halogen:queue_gave_up_total{job=\"local-llm\",served_model=~\"$model\"}[$__rate_interval])",
          "legendFormat": "{{instance}} · left queue"
        },
        {
          "refId": "B",
          "expr": "60 * rate(ds4_requests_total{job=\"local-llm\",served_model=~\"$model\",outcome!=\"completed\"}[$__rate_interval])",
          "legendFormat": "{{instance}} · {{outcome}}"
        }
      ]
    }
  ]
}

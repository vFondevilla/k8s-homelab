[Unit]
Description=DeepSeek V4 Flash inference server (CUDA / DSpark)
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=%h/code/ds4
Environment=DS4_SRC_DIR=%h/code/ds4
Environment=DS4_GGUF_DIR=%h/gguf
ExecStart=%h/.local/bin/ds4-serve --host 0.0.0.0 --port 8000
# Model loading and CUDA warmup must finish before the service is ready.
ExecStartPost=/usr/bin/curl --fail --silent --show-error --output /dev/null --retry 120 --retry-connrefused --retry-delay 2 --retry-max-time 280 --connect-timeout 2 --max-time 5 http://127.0.0.1:8000/v1/models
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=default.target

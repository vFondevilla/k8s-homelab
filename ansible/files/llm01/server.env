# Halogen 0.18.5 on llm01: Ryzen AI Max+ 395, 128 GB RAM.
# Favor interactive chat and coding. Client request fields override defaults.
HALOGEN_REASONING_EFFORT=medium

# Keep the native context and four serving slots. The shared pool holds one
# full-length conversation, or several shorter conversations totaling 262k.
# Compared with the image defaults, pool and scratch use about 11.6 GiB less.
HALOGEN_CTX=262144
HALOGEN_KV_SLOTS=4
HALOGEN_KV_POOL_POSITIONS=262144
HALOGEN_MAX_TOK=16384
HALOGEN_PREFILL_CHUNK=16384

# Keep speculative decoding and prompt-cache behavior at the image defaults.
# Persist cache on the existing NVMe bind mount; bound this configuration to
# 32 GiB. Different engine versions/settings keep separate cache directories.
HALOGEN_CACHE_DIR=/models/.halogen-cache
HALOGEN_CACHE_DISK_GIB=32

# Repository configuration: non-secret settings and 1Password references only.
# op run resolves credentials at runtime. Never put credential values here.

# Non-secret R2 account and bucket identifiers.
R2_ACCOUNT_ID=2b25817e2dc1c6293627c2ba85435bd2
R2_BUCKET=homelab-tfstate

# Create an R2 Object Read & Write token scoped to this bucket.
AWS_ACCESS_KEY_ID=op://Lab/homelab-r2-state/username
AWS_SECRET_ACCESS_KEY=op://Lab/homelab-r2-state/credential

UNIFI_API_KEY="op://Personal/unifi api key codex/credential"
UNIFI_CLOUD_CONNECTOR=true
UNIFI_HARDWARE_ID=3efdcc5f-20d4-5234-887b-246d520c75c9
UNIFI_SITE=default
# For direct local access, disable Cloud Connector and use a local API key.
# Set true only if that gateway uses an untrusted local certificate.
UNIFI_INSECURE=false
